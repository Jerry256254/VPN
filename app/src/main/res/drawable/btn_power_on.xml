<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="46dp"
                android:startColor="@color/power_on_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/power_on_fill" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
